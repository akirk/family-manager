{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Households",
		"description": "A WordPress app for running a household, or several. A home is a place with its own address: its people, the facts the house needs you to know, the things kept there and what needs doing. Opened in desktop mode with the OpenStation plugin.",
		"author": "Alex Kirk",
		"categories": [
			"Apps",
			"Productivity"
		]
	},
	"landingPage": "/wp-admin/index.php?desktop_mode_portal=1",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/openstation/releases/latest/download/openstation.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/households",
				"ref": "dist/main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "households"
			}
		}
	]
}
